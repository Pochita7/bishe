# Text LLM, currently DeepSeek official OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Vision provider for GAIA image/video questions.
# For Doubao/VolcEngine Ark, put the old VolcEngine key here or in ARK_API_KEY.
GAIA_VISION_API_KEY=
GAIA_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Use your Doubao vision endpoint ID, usually ep-..., or a model name accepted
# by your VolcEngine Ark account.
GAIA_VISION_MODEL=
GAIA_VISION_TIMEOUT=300
GAIA_VISION_MAX_TOKENS=700
GAIA_VISION_MAX_RETRIES=0
GAIA_VISION_MAX_IMAGE_SIDE=1800
GAIA_VISION_MAX_IMAGE_BYTES=4000000
MAS_MEDIA_WORKER_TIMEOUT=600

# Optional aliases also supported by gaia_solver/config.py:
# ARK_API_KEY=
# DOUBAO_API_KEY=
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_VISION_MODEL=

# Audio transcription provider. Leave unset to reuse the vision provider.
GAIA_AUDIO_API_KEY=
GAIA_AUDIO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
GAIA_AUDIO_MODEL=
GAIA_AUDIO_INPUT_MODE=chat
GAIA_AUDIO_MAX_RETRIES=0
